# ────────────────────────────────────────────────────────────────────────────
# Omega-LB — Environment Variables Reference
#
# Copy this file to `.env` and fill in the values for your environment.
# NEVER commit .env to version control (it is in .gitignore).
#
# Load in shell:   set -a; source .env; set +a
# Load in Python:  pip install python-dotenv; from dotenv import load_dotenv; load_dotenv()
# ────────────────────────────────────────────────────────────────────────────

# ── Proxy ──────────────────────────────────────────────────────────────────
OMEGA_LB_HOST=127.0.0.1
OMEGA_LB_PORT=8080

# Comma-separated list of backends as host:port
OMEGA_LB_BACKENDS=127.0.0.1:9000,127.0.0.1:9001,127.0.0.1:9002,127.0.0.1:9003

# Log verbosity: DEBUG | INFO | WARNING | ERROR
OMEGA_LB_LOG_LEVEL=INFO

# ── CBF Safety Controller ──────────────────────────────────────────────────
# Maximum fraction of total traffic any single backend may receive.
# Must be in (0.0, 1.0].  Default: 0.80 (80%).
OMEGA_LB_CBF_CAP=0.80

# CBF Lyapunov stability parameter λ.  Higher = more aggressive projection.
OMEGA_LB_CBF_LAMBDA=0.5

# ── Rate Limiting (token-bucket per backend) ───────────────────────────────
OMEGA_LB_INIT_RPS=1000
OMEGA_LB_MIN_RPS=100
OMEGA_LB_MAX_RPS=5000

# ── KAN Neural Routing ─────────────────────────────────────────────────────
# Path to the exported ONNX actor model.  If absent, the proxy falls back to
# the pure-Python symbolic KAN (no GPU/PyTorch required).
OMEGA_LB_KAN_MODEL=ml/models/kan_actor.onnx

# ── H&A Consistent Hash Ring ──────────────────────────────────────────────
# Number of virtual nodes per backend on the ring.
# More vnodes = better distribution, more memory.
OMEGA_LB_RING_VNODES=150

# ── Health Checker ─────────────────────────────────────────────────────────
# How often (seconds) to actively probe each backend.
OMEGA_LB_HEALTH_INTERVAL_S=5

# Consecutive failures before a backend is marked unhealthy.
OMEGA_LB_HEALTH_FAIL_THRESHOLD=3

# Consecutive successes before a backend is reinstated.
OMEGA_LB_HEALTH_PASS_THRESHOLD=2

# ── Dashboard ──────────────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=127.0.0.1
# Set to "false" to open a browser automatically on start.
STREAMLIT_SERVER_HEADLESS=true

# ── OpenTelemetry / Observability ──────────────────────────────────────────
# Endpoint for OTLP gRPC exporter (Go control plane).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=omega-lb
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# Prometheus scrape port (Go control plane exposes /metrics here).
OMEGA_LB_METRICS_PORT=9090

# ── Development Overrides ──────────────────────────────────────────────────
# Set to "1" to skip integration tests in pytest.
# SKIP_INTEGRATION=1

# Set to "1" to enable verbose proxy request logging.
# OMEGA_LB_DEBUG_REQUESTS=1
